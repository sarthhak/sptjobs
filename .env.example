# Copy to .env and fill in. Never commit .env.

# Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Password for the web app. Required when the app is reachable from other machines.
APP_PASSWORD=

# Google access - choose ONE:
#  a) Service account key file (recommended for a hosted app)
GOOGLE_SERVICE_ACCOUNT_FILE=
#  b) OAuth token created by `python scripts/google_login.py` (default location below)
# GOOGLE_TOKEN_FILE=data/google_token.json

# GTM safety switch. Leave false until you've tried the read-only features.
ALLOW_GTM_WRITES=false

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high
# SITE_URL=https://www.example.com      # checked in a headless browser after each publish
# TAG_NAMING_PATTERN=^[^-]+ - [^-]+ - .+$
# GTM_WRITE_INTERVAL=4                  # seconds between GTM write calls (API quota)
# CHROMIUM_PATH=                        # use an existing Chrome/Chromium for site checks
# DATA_DIR=data
